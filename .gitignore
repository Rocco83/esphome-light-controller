# KinderLight RGB - .gitignore

# Editor
*.bak
*.tmp
*.swp
*.swo
*.swn

# OS
Thumbs.db
ehthumbs.db

# KiCad
*.backup
*.kicad_prl
*.kicad_wks
*.kicad_sch-bak
*-cache.lib
*-rescue.kicad_sch
*-rescue.*
*-bak.kicad_pcb
*-bak.kicad_sch

# Output
/gerbers_front/
/gerbers_rear/
/build/
/dist/

# Other temporary files
*.zip
*.tar.gz
*.7z

# standard files to not version
*.log
*.aux
*.out
*.toc

# files with passwords
# secrets is also in the firmware directory
secrets.yaml

# compiled files
.esphome/
.platformio/

# macOS metadata (AppleDouble sidecars, Finder state, resource forks)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.apdisk
__MACOSX/
